# Copy to .env for local dev. In production set these in Coolify's env vars.

# --- Auth (required) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Signs the session cookie. Use a long random string (32+ chars).
SESSION_SECRET=replace-with-a-long-random-secret

# --- Meridian (Anthropic-compatible proxy in front of your Claude session) ---
# Across Coolify services use the Meridian service name, e.g. http://meridian:8080
MERIDIAN_BASE_URL=http://localhost:8080
# Placeholder the Anthropic SDK requires; Meridian auths via your Claude session.
MERIDIAN_API_KEY=meridian
# Heavy tier — agents' deliverables, planning, synthesis.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Light tier — review, routing, memory notes, the AUTO demo.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# AUTO demo model (defaults to the light tier). Set "" for pure simulation.
# DEMO_MODEL=claude-haiku-4-5-20251001
# Force the no-LLM simulation (office still runs end-to-end).
# SIMULATE=true

# --- Database ---
# Without DATABASE_URL the server keeps state in memory (resets on restart).
# DATABASE_URL=postgres://mission:mission@localhost:5432/missioncontrol

# --- Tuning (optional) ---
# PORT=3000
# TICK_MS=1500
# AUTONOMOUS=true
# DAILY_BUDGET_USD=0
