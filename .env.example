# --- HTTP server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Meridian (Anthropic-compatible proxy in front of your Claude Max/Pro) ---
# When agent + Meridian run as separate Coolify services on the same network,
# use the Meridian service name instead of localhost, e.g. http://meridian:8080
MERIDIAN_BASE_URL=http://localhost:8080
# Meridian authenticates via your local Claude Code session, so this is a
# placeholder the Anthropic SDK requires; any non-empty string works.
MERIDIAN_API_KEY=meridian

# Model name passed to Meridian (it maps this onto your Claude Code subscription).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Generous so full HTML pages / SVG logos aren't cut off mid-output.
MAX_TOKENS=8192

# --- Agent behaviour ---
# Leave SYSTEM_PROMPT unset to use the built-in artifact-oriented default (it
# steers the agent to emit self-contained HTML/SVG that the preview pane renders).
# Override here only if you want different behaviour.
# SYSTEM_PROMPT=You are a helpful AI assistant with access to tools.
# Safety cap on how many tool-call round trips a single request may take.
MAX_TOOL_ITERATIONS=8
# Directory where conversations are persisted (one JSON file per conversation).
# In Docker this defaults to /app/data — mount a volume there to keep history.
DATA_DIR=./data

# --- Auth ---
# If set, callers must send `Authorization: Bearer <this value>`.
# Strongly recommended once the agent is exposed via Coolify. Leave blank to disable.
AGENT_API_KEY=
