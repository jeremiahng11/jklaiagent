# Copy to .env for local dev. In production set these in Coolify's env vars.

# --- Auth (required) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Signs the session cookie. Use a long random string (32+ chars).
SESSION_SECRET=replace-with-a-long-random-secret

# --- Meridian (Anthropic-compatible proxy in front of your Claude session) ---
# Across Coolify services use the Meridian service name, e.g. http://meridian:8080
MERIDIAN_BASE_URL=http://localhost:8080
# Placeholder the Anthropic SDK requires; Meridian auths via your Claude session.
MERIDIAN_API_KEY=meridian
# Heavy tier — agents' deliverables, planning, synthesis.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Light tier — review, routing, memory notes, the AUTO demo.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# AUTO demo mode is always simulated — visual entertainment only, no model
# calls and no cost. Only tasks YOU assign use Claude via Meridian.
# Force the WHOLE office into no-LLM simulation (even your tasks):
# SIMULATE=true

# --- Semantic memory (RAG) ---
# Embeddings run locally via Transformers.js (no key, no network at runtime —
# the model is cached into the image at build). Override the model if you like.
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# --- Database ---
# Without DATABASE_URL the server keeps state in memory (resets on restart).
# DATABASE_URL=postgres://mission:mission@localhost:5432/missioncontrol

# --- Tuning (optional) ---
# PORT=3000
# TICK_MS=1500
# AUTONOMOUS=true
# DAILY_BUDGET_USD=0
# Seed a 20-task "Visa Payment App" showcase mission on first boot (simulated,
# no AI calls). Idempotent — won't duplicate on restart.
# SEED_DEMO=true

# --- Build depth / speed ---
# Balanced defaults. Raise for max-quality (slower) builds.
# BUILD_MAX_TOKENS=18000          # ~32000 for max-quality builds
# BUILD_QA_FIX=true               # also auto-fix Scout's QA findings (slower)
