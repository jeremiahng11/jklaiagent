# Copy to .env for local dev. In production set these in Coolify's env vars.

# --- Auth (required) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Signs the session cookie. Use a long random string (32+ chars).
SESSION_SECRET=replace-with-a-long-random-secret

# --- Claude (via the Claude Code SDK, DIRECT — no Meridian) ---
# The agents call Claude through @anthropic-ai/claude-agent-sdk using your Claude
# Code / Max session (fast, ~30x quicker than the Meridian proxy). The runtime
# MUST be authenticated. Easiest: run `claude setup-token` where you're logged in
# to Claude Code, then set the token here (works headless in Docker):
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# (Meridian is no longer used. MERIDIAN_* vars are ignored.)
# Heavy tier — agents' deliverables, planning, synthesis.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Light tier — review, routing, memory notes, the AUTO demo.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# AUTO demo mode is always simulated — visual only, no model calls, no cost.
# Force the WHOLE office into no-LLM simulation (even your tasks):
# SIMULATE=true

# --- Semantic memory (RAG) ---
# Embeddings run locally via Transformers.js (all-MiniLM-L6-v2, 384-dim, ~25MB,
# CPU-only — no key, no network at runtime). The model is baked into the image at
# build AND seeded into a persistent cache on first boot. Agents recall relevant
# past work ACROSS ALL departments by meaning, and store a note after each task.
# Cache dir defaults to DATA_DIR/.models (persistent); override if needed:
# EMBED_CACHE_DIR=/app/data/.models
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# --- Persistence ---
# With DATABASE_URL, state is stored in Postgres (durable).
# DATABASE_URL=postgres://mission:mission@localhost:5432/missioncontrol
# WITHOUT Postgres, state is snapshotted to DATA_DIR/state.json. Mount a volume
# at DATA_DIR (Coolify destination /app/data) so completed tasks survive redeploys.
# DATA_DIR=/app/data

# --- Tuning (optional) ---
# PORT=3000
# TICK_MS=1500
# AUTONOMOUS=true
# DAILY_BUDGET_USD=0
# Seed a 20-task "Visa Payment App" showcase mission on first boot (simulated,
# no AI calls). Idempotent — won't duplicate on restart.
# SEED_DEMO=true

# --- Build depth / speed ---
# Claude Code SDK direct is fast (~56 tok/s), so the only real variable is how
# much the build asks for. Two modes:
#   BUILD_SCOPE=full     (default) — exhaustive 12-20+ screen build (~12-18 min)
#   BUILD_SCOPE=focused  — tight 6-8 core screens (~4-6 min), then extend via
#                          "Follow up" on the finished build (recommended workflow)
# LLM_TIMEOUT_MS = max time before a build is force-stopped and its partial saved.
# Give a FULL build room (default 1200000 = 20 min); a focused build needs less.
#   BUILD_SCOPE=focused
#   LLM_TIMEOUT_MS=1200000
#   BUILD_PASSES=1                 (2+ = deeper, but doubles time)
# LLM_MAX_TURNS=8 lets the agent finish; raise only if you see "max turns" errors.
